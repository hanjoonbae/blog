---
import type { CollectionEntry } from 'astro:content';

interface Props {
  posts: CollectionEntry<'blog'>[];
  emptyText?: string;
}

const { posts, emptyText = '아직 공개된 글이 없습니다.' } = Astro.props;
---

{posts.length > 0 ? (
  <ol class="post-list">
    {posts.map((post) => {
      const d = post.data.pubDate;
      const mm = String(d.getMonth() + 1).padStart(2, '0');
      const yyyy = d.getFullYear();
      return (
        <li>
          <a class="post-row-simple" href={'/blog/' + post.id + '/'}>
            <time class="post-date-simple" datetime={d.toISOString()}>{mm}/{yyyy}</time>
            <span class="post-title-simple">{post.data.title}</span>
          </a>
        </li>
      );
    })}
  </ol>
) : (
  <p class="empty-state">{emptyText}</p>
)}
