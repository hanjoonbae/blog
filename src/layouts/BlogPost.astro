---
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';

type Props = CollectionEntry<'blog'>['data'] & { readingTime: number };

const { title, description, pubDate, readingTime } = Astro.props;
const formattedDate = pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
---

<!doctype html>
<html lang="ko">
  <head>
    <BaseHead title={title} description={description} />
  </head>
  <body>
    <Header showHero={false} />
    <main>
      <article class="prose">
        <header class="post-header">
          <h1 class="post-heading">{title}</h1>
          <p class="post-byline">
            <time datetime={pubDate.toISOString()}>{formattedDate}</time>
            <span aria-hidden="true">•</span>
            <span>{readingTime} min read</span>
          </p>
        </header>
        <slot />
      </article>
    </main>
    <Footer />
  </body>
</html>
