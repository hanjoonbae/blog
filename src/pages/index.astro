---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import PostList from '../components/PostList.astro';
import SocialLinks from '../components/SocialLinks.astro';
import { CATEGORIES } from '../lib/categories';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const posts = (await getCollection('blog'))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 8);
---

<!doctype html>
<html lang="ko">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
    <script is:inline>
      // Set .is-intro BEFORE first paint so .intro-seq elements never flash
      // fully-shown before the staggered entrance. Once per session only.
      (function () {
        try {
          if (!sessionStorage.getItem("intro-played")) {
            document.documentElement.classList.add("is-intro");
            sessionStorage.setItem("intro-played", "1");
          }
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <Header />
    <main>
      <section class="intro intro-seq" style="--seq-delay: 0.65s" aria-labelledby="intro-title">
        <SocialLinks />
      </section>

      <a class="intro-card intro-seq" style="--seq-delay: 0.9s" href="/about/">
        <span class="intro-card-name">Hanjoon Bae</span>
        <span class="intro-card-desc">Studying Materials Science & Data Science</span>
        <span class="intro-card-arrow" aria-hidden="true">→</span>
      </a>

      <section aria-labelledby="categories">
        <ol class="category-list category-grid intro-seq" style="--seq-delay: 1.15s">
          {CATEGORIES.map((category, i) => (
            <li style={`--cell-i: ${i}`}>
              <a class="category-row" href={category.href}>
                <span>{category.label}</span>
              </a>
            </li>
          ))}
        </ol>
      </section>

      <section class="intro-seq" style="--seq-delay: 1.5s" aria-labelledby="recent-posts">
        <div class="section-heading">
          <h3 id="recent-posts">Recent Posts</h3>
          <a href="/blog/">All posts</a>
        </div>
        <PostList posts={posts} emptyText="아직 공개된 글이 없습니다." />
      </section>
    </main>
    <Footer />

    <script is:inline>
      // The head script arms .is-intro before first paint. With <ClientRouter/>,
      // navigating swaps the DOM without re-running the head script, so re-run
      // the same once-per-session check after each swap: play the intro the
      // first time the homepage is reached this session, skip it otherwise.
      document.addEventListener("astro:after-swap", function () {
        var html = document.documentElement;
        var onHome =
          location.pathname === "/" || location.pathname === "/index.html";
        var seen = false;
        try {
          seen = !!sessionStorage.getItem("intro-played");
        } catch (e) {}
        if (onHome && !seen) {
          html.classList.add("is-intro");
          try {
            sessionStorage.setItem("intro-played", "1");
          } catch (e) {}
        } else {
          html.classList.remove("is-intro");
        }
      });
    </script>
  </body>
</html>
