---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { CATEGORIES } from '../lib/categories';
---

<!doctype html>
<html lang="ko">
  <head>
    <BaseHead title="Write" description="로컬에서 Markdown 글을 생성하고 수정합니다." />
  </head>
  <body>
    <Header />
    <main>
      <section class="page-title" aria-labelledby="write-title">
        <h1 id="write-title">Write</h1>
        <p>로컬에서 글을 작성하거나 기존 Markdown 글을 불러와 수정합니다.</p>
      </section>

      <section class="editor-panel" aria-labelledby="existing-posts">
        <h2 id="existing-posts">Existing Posts</h2>
        <div class="field-row editor-load-row">
          <label>
            <span>Post</span>
            <select id="post-select">
              <option value="">새 글 작성</option>
            </select>
          </label>
          <div class="action-row compact-actions">
            <button type="button" id="load-post">Load</button>
            <button type="button" id="new-post">New</button>
          </div>
        </div>
      </section>

      <form class="editor-form" id="post-form">
        <input name="originalSlug" type="hidden" />
        <div class="field-row two-col">
          <label>
            <span>Title</span>
            <input name="title" required autocomplete="off" placeholder="예: Databricks SQL EXPLAIN 읽기" />
          </label>
          <label>
            <span>Slug</span>
            <input name="slug" autocomplete="off" placeholder="비워두면 제목으로 생성" />
          </label>
        </div>

        <label>
          <span>Description</span>
          <input name="description" required autocomplete="off" placeholder="목록과 메타 태그에 들어갈 한 줄 설명" />
        </label>

        <div class="field-row three-col">
          <label>
            <span>Category</span>
            <select name="category" required>
              {CATEGORIES.map((category) => <option value={category.id}>{category.label}</option>)}
            </select>
          </label>
          <label>
            <span>Date</span>
            <input name="pubDate" type="date" required />
          </label>
          <label>
            <span>Tags</span>
            <input name="tags" autocomplete="off" placeholder="aws, exam, note" />
          </label>
        </div>

        <label>
          <span>Markdown file</span>
          <input id="file-input" type="file" accept=".md,.mdx,text/markdown,text/plain" />
        </label>

        <label>
          <span>Body</span>
          <textarea name="body" required rows="18" spellcheck="false" placeholder="Markdown으로 글을 작성하세요."></textarea>
        </label>

        <div class="options-row">
          <label class="check-label"><input name="draft" type="checkbox" /> Draft</label>
          <label class="check-label"><input name="overwrite" type="checkbox" /> Overwrite slug collision</label>
        </div>

        <div class="action-row">
          <button type="submit">Save post</button>
          <a id="preview-link" href="/blog/" aria-disabled="true">Open post</a>
        </div>

        <p class="form-status" id="form-status" role="status"></p>
      </form>
    </main>
    <Footer />

    <script>
      const form = document.querySelector('#post-form');
      const fileInput = document.querySelector('#file-input');
      const postSelect = document.querySelector('#post-select');
      const loadPostButton = document.querySelector('#load-post');
      const newPostButton = document.querySelector('#new-post');
      const statusEl = document.querySelector('#form-status');
      const previewLink = document.querySelector('#preview-link');
      const writerUrl = '/api/local-posts';

      const today = new Date().toISOString().slice(0, 10);
      resetForm();
      loadPostList();

      function setStatus(message, state = '') {
        statusEl.textContent = message;
        statusEl.dataset.state = state;
      }

      function slugify(value) {
        return String(value || '')
          .normalize('NFKC')
          .trim()
          .toLowerCase()
          .replace(/[\/\?%*:|"<>]/g, '')
          .replace(/[^\p{Letter}\p{Number}._ -]+/gu, '')
          .replace(/\s+/g, '-')
          .replace(/-+/g, '-')
          .replace(/^[._-]+|[._-]+$/g, '')
          .slice(0, 90);
      }

      function parseFrontmatter(text) {
        const match = text.match(/^---\n([\s\S]*?)\n---\n?/);
        if (!match) return { data: {}, body: text };
        const data = {};
        let listKey = null;
        for (const line of match[1].split('\n')) {
          const item = line.match(/^([A-Za-z0-9_-]+):\s*(.*)$/);
          if (item) {
            const key = item[1];
            let value = item[2].trim();
            if (value === '') {
              data[key] = [];
              listKey = key;
            } else if (value === '[]') {
              data[key] = [];
              listKey = null;
            } else {
              if ((value.startsWith('"') && value.endsWith('"')) || (value.startsWith("'") && value.endsWith("'"))) {
                value = value.slice(1, -1);
              }
              data[key] = value;
              listKey = null;
            }
            continue;
          }
          const listItem = line.match(/^\s*-\s*(.*)$/);
          if (listKey && listItem) data[listKey].push(listItem[1].replace(/^['"]|['"]$/g, ''));
        }
        return { data, body: text.slice(match[0].length) };
      }

      function resetForm() {
        form.reset();
        form.elements.pubDate.value = today;
        form.elements.originalSlug.value = '';
        previewLink.href = '/blog/';
        previewLink.setAttribute('aria-disabled', 'true');
        fileInput.value = '';
        setStatus('', '');
      }

      function fillForm(post) {
        form.elements.originalSlug.value = post.slug || '';
        form.elements.title.value = post.title || '';
        form.elements.description.value = post.description || '';
        form.elements.slug.value = post.slug || '';
        form.elements.category.value = post.category || 'study';
        form.elements.pubDate.value = post.pubDate || today;
        form.elements.tags.value = Array.isArray(post.tags) ? post.tags.join(', ') : post.tags || '';
        form.elements.body.value = (post.body || '').trim();
        form.elements.draft.checked = Boolean(post.draft);
        form.elements.overwrite.checked = false;
        previewLink.href = post.url || ('/blog/' + post.slug + '/');
        previewLink.removeAttribute('aria-disabled');
      }

      async function loadPostList(selectedSlug = '') {
        const response = await fetch(writerUrl);
        const result = await response.json();
        if (!response.ok || !result.ok) throw new Error(result.error || 'Could not load posts.');
        const currentValue = selectedSlug || postSelect.value;
        postSelect.replaceChildren(new Option('새 글 작성', ''));
        for (const post of result.posts) {
          const label = post.title + ' · ' + post.slug;
          postSelect.append(new Option(label, post.slug));
        }
        postSelect.value = currentValue;
      }

      async function loadSelectedPost() {
        const slug = postSelect.value;
        if (!slug) {
          resetForm();
          setStatus('New post form is ready.', 'ok');
          return;
        }
        setStatus('Loading...', '');
        const response = await fetch(writerUrl + '?slug=' + encodeURIComponent(slug));
        const result = await response.json();
        if (!response.ok || !result.ok) throw new Error(result.error || 'Could not load post.');
        fillForm(result.post);
        setStatus('Loaded ' + result.post.path + '.', 'ok');
      }

      fileInput.addEventListener('change', async () => {
        const file = fileInput.files?.[0];
        if (!file) return;
        const text = await file.text();
        const parsed = parseFrontmatter(text.replace(/\r\n/g, '\n'));
        const filenameSlug = file.name.replace(/\.(md|mdx)$/i, '');
        form.elements.originalSlug.value = '';
        form.elements.title.value = parsed.data.title || form.elements.title.value || filenameSlug;
        form.elements.description.value = parsed.data.description || form.elements.description.value;
        form.elements.slug.value = form.elements.slug.value || slugify(filenameSlug);
        form.elements.pubDate.value = parsed.data.pubDate || form.elements.pubDate.value || today;
        if (parsed.data.category) form.elements.category.value = parsed.data.category;
        if (parsed.data.tags && !form.elements.tags.value) {
          form.elements.tags.value = Array.isArray(parsed.data.tags) ? parsed.data.tags.join(', ') : parsed.data.tags;
        }
        form.elements.body.value = parsed.body.trim();
        postSelect.value = '';
        previewLink.setAttribute('aria-disabled', 'true');
        setStatus('Markdown file loaded as a new post. Review the fields, then save.', 'ok');
      });

      form.elements.title.addEventListener('blur', () => {
        if (!form.elements.slug.value) form.elements.slug.value = slugify(form.elements.title.value);
      });

      loadPostButton.addEventListener('click', () => {
        loadSelectedPost().catch((error) => setStatus(error.message, 'error'));
      });

      postSelect.addEventListener('change', () => {
        if (postSelect.value) loadSelectedPost().catch((error) => setStatus(error.message, 'error'));
      });

      newPostButton.addEventListener('click', () => {
        postSelect.value = '';
        resetForm();
        setStatus('New post form is ready.', 'ok');
      });

      form.addEventListener('submit', async (event) => {
        event.preventDefault();
        setStatus('Saving...', '');
        previewLink.setAttribute('aria-disabled', 'true');
        const payload = Object.fromEntries(new FormData(form).entries());
        payload.draft = form.elements.draft.checked;
        payload.overwrite = form.elements.overwrite.checked;
        payload.slug = payload.slug || slugify(payload.title);

        try {
          const response = await fetch(writerUrl, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload),
          });
          const result = await response.json();
          if (!response.ok || !result.ok) throw new Error(result.error || 'Could not save post.');
          form.elements.originalSlug.value = result.post.slug;
          form.elements.slug.value = result.post.slug;
          previewLink.href = result.post.url;
          previewLink.removeAttribute('aria-disabled');
          await loadPostList(result.post.slug);
          setStatus('Saved to ' + result.post.path + '. Astro will reload the post list.', 'ok');
        } catch (error) {
          setStatus(error.message + ' Make sure the Astro dev server is running with npm run dev.', 'error');
        }
      });
    </script>
  </body>
</html>
